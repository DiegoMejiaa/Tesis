# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# SECRETO: la config con la API key de Gemini NO va al repo (contiene la key
# en texto plano). Se versiona solo la plantilla lib/config_llm.dart.example.
# Cada máquina crea su lib/config_llm.dart local a partir de la plantilla.
/lib/config_llm.dart

# Estado local de herramientas (no es código del proyecto)
.tokensave/
.agents/
.claude/settings.local.json

# Artefactos de Gradle (Android)
/android/build/
/android/.gradle/
# Cache de Gradle del plugin Bluetooth vendorizado en packages/ (no es codigo).
packages/**/android/.gradle/
packages/**/android/build/
