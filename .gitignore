# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Estado local de herramientas (no es código del proyecto)
.tokensave/
.agents/
.claude/settings.local.json

# Artefactos de Gradle (Android)
/android/build/
/android/.gradle/
# Cache de Gradle del plugin Bluetooth vendorizado en packages/ (no es codigo).
packages/**/android/.gradle/
packages/**/android/build/
